+        </SelectContent>
+      </Select>
+    </label>
+  );
+}
+function RunFilters({ search, onChange }: { search: RunSearch; onChange: (next: RunSearch) => void }) {
+  const [q, setQ] = useState(search.q ?? '');
+  const [error, setError] = useState('');
