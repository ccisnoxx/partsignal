+          unknown
+            ? '重新分析结果未知，离开会丢失本次诊断信息，请先重读分析历史核对。'
+            : undefined
+        }
+        shouldBlockNavigation={({ current, next }) =>
+          shouldBlockManualNavigation(current, next)
+        }
+      />
+      {!open && offered && (
+        <Button
+          ref={entry}
+          type="button"
+          variant="outline"
+          disabled={blocked || busy || !csrfToken}
+          onClick={() => {
