+      </span>
+      {unrecoverable ? (
+        <span>当前资源不可访问，请返回列表或关闭详情。</span>
+      ) : (
+        <Button onClick={onRetry} size="sm" type="button" variant="outline">
+          重试读取
+        </Button>
+      )}
+    </div>
+  );
+}
+export { RunsPage };
