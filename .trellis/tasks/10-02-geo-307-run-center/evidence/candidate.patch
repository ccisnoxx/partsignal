+      {list.isFetching && (
+        <p className="text-sm" role="status">
+          {list.data ? '正在刷新列表…' : '正在读取列表…'}
+        </p>
+      )}
+      {list.error && (
+        <ReadFailure error={list.error} onRetry={() => void list.refetch()} retained={Boolean(list.data)} />
+      )}
+      {runs
