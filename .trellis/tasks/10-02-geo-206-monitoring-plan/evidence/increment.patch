+    targets = [
+        (f"/api/v1/geo/subjects/{subject['id']}", "GEO_SUBJECT_IN_USE"),
+        (f"/api/v1/geo/prompt-variants/{variant_id}", "GEO_PROMPT_VARIANT_IN_USE"),
