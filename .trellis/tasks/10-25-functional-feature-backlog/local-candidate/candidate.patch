+                    stale ||
+                    !offered ||
+                    !csrfToken ||
+                    !form.formState.isValid
+                  }
+                >
+                  确认重新分析
+                </Button>
+                <Button
+                  type="button"
+                  variant="ghost"
+                  disabled={busy}
+                  onClick={() => {
+                    setOpen(false);
+                    setHeld(false);
+                    setRequest(undefined);
+                    form.reset({ reason: '' });
+                    queueMicrotask(() => entry.current?.focus());
+                  }}
+                >
+                  取消发起
+                </Button>
+                {Boolean(error) && (
+                  <Button
+                    type="button"
+                    variant="outline"
+                    disabled={busy}
+                    onClick={() => void refresh()}
+                  >
+                    重新读取运行
+                  </Button>
+                )}
+              </div>
+            )}
+          </form>
+        </FormProvider>
+      )}
+    </section>
+  );
+}
