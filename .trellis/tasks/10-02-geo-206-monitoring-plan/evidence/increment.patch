+        session.add(plan)
+        session.flush()
+        for suffix, column, resource in [
+            ("subjects", "subject_id", subject["id"]),
+            ("prompts", "prompt_variant_id", str(variant.id)),
+            ("profiles", "collection_profile_id", profile["summary"]["id"]),
+        ]:
