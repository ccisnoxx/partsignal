+    assert card.unjudgeable_claim_count == 1
+    pieces = parts[cells[0].cell_key, "accurate_claim_rate"]
+    assert sum(p.numerator for p in pieces) == card.numerator
+    assert sum(p.denominator for p in pieces) == card.denominator
