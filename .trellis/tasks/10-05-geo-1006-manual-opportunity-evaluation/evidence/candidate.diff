+def test_concurrent_same_key_returns_one_frozen_receipt(api):
+    _, filters, _ = prepared(api)
+    value = GeoOpportunityEvaluationRequest.model_validate(payload(api, filters))
+    key, barrier = str(uuid4()), Barrier(2)
