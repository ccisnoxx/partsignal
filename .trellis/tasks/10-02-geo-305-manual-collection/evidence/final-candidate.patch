+                    request_id=str(uuid4()),
+                ).run_revision
+            except AppError as error:
+                return error.code
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(invoke, range(2)))
+    assert sorted(results, key=str) == [1, "INVALID_STATE_TRANSITION"]
