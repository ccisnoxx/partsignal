+    """对象仍存在，但完整性元数据与已验证引用不一致。"""
+
+
+def verify_stored_object(
+    storage: EvidenceStorage,
+    object_key: str,
+    expected: ObjectMetadata,
+) -> None:
+    """关联历史证据前复核真实 HEAD；不签发公开 URL 或改变文件状态。"""
+    actual = storage.head(object_key, datetime.now(UTC) + timedelta(seconds=60))
+    if actual != expected:
+        raise StorageIntegrityError("对象大小、哈希或类型与已验证文件不一致")
+
