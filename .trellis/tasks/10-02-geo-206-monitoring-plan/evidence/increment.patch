+            display_name="虚构维护者",
+            password_hash="unused",
+            account_type="ENGINEER",
+            is_active=False,
+            must_change_password=False,
+            revision=0,
+        )
+        session.add(updater)
+        topic = QueryTopic(
+            canonical_question="虚构206问题", intent_type="REPLACEMENT", variants=[], revision=0
+        )
+        session.add(topic)
+        session.flush()
+        variant = GeoPromptVariant(
