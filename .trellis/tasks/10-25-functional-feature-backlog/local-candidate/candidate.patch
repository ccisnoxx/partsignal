+@pytest.mark.parametrize("sort", ["PRIORITY_DESC", "CREATED_DESC", "LAST_SEEN_DESC"])
+def test_full_filtered_set_keyset_order_ties_and_saved_source_dedup(api, monkeypatch, sort):
