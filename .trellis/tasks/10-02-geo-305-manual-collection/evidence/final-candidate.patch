+    assert submit(api, run, value).status_code == 201
+    invalid = api.api.engineer.post(
+        prefix(run) + "/manual-submit",
+        json=value,
+        headers={"Idempotency-Key": "submit", "X-CSRF-Token": "a" * 32},
+    )
