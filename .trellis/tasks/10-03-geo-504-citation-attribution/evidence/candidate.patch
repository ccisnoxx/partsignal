+def test_snapshot_freezes_catalog_rule_version_and_original_positions():
+    values = [subject()]
+    entries = [("geo-fixture-media.test", GeoSourceCategory.INDUSTRY_MEDIA)]
+    sources = freeze_source_categories("fixture-v1", entries)
