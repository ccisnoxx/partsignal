# 开发模板：复制为根目录 .env；生产使用独立的 .env.production.example。
# 完整配置归属与交付流程见 docs/production-configuration.md。
# 服务器开发预览使用 .env.staging.example；说明见 docs/development-preview.md。
# 应用环境与入口。
APP_ENV=development
# 下列三个历史记录字段目前不被 Settings/Compose 读取，修改它们不会改变运行行为。
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://api:8000
LOG_LEVEL=INFO

# PostgreSQL 与 Redis。Production secret 由目标主机安全随机生成，不从本文件复制。
DATABASE_URL=postgresql+psycopg://partsignal:partsignal_dev@postgres:5432/partsignal
POSTGRES_DB=partsignal
POSTGRES_USER=partsignal
POSTGRES_PASSWORD=partsignal_dev
REDIS_URL=redis://redis:6379/0

# Session、CSRF 与浏览器边界。
SESSION_SECRET=development-only-change-me-32-bytes
SESSION_COOKIE_NAME=partsignal_session
CSRF_COOKIE_NAME=partsignal_csrf
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 空库初始化账号。
PARTSIGNAL_SEED_ADMIN_PASSWORD=partsignal-admin-dev
PARTSIGNAL_SEED_ENGINEER_PASSWORD=partsignal-engineer-dev
CELERY_CONCURRENCY=1

# CELERY_CONCURRENCY 在进程启动时生效，范围1–10；提升前须验证内存与Profile准入容量。
# AI 运行时。供应商、模型、API Key 属于数据库配置，不由 env 加载。
# Production clean-init 首次录入使用受控 TTY bootstrap；后续由 AI Channel 管理。
# deterministic 兼容值关闭正式生成/自然化/重试，不产生假 AI 内容；真实业务需 openai-compatible。
# 管理员显式模型测试/发现仍独立允许；模式在进程启动时读取。
CONTENT_GENERATOR=deterministic
AI_CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AI_ALLOW_LOCAL_HTTP=true
GENERATION_EAGER=false
GENERATION_PENDING_REDISPATCH_SECONDS=120
GENERATION_FINALIZE_GRACE_SECONDS=120
GENERATION_RECOVERY_BATCH_SIZE=100
GENERATION_RECOVERY_SCAN_SECONDS=60

# 新 GEO 能力渐进启用：全部默认关闭；子开关为 true 时总开关必须为 true。
# API/Worker/Scheduler 共同加载；修改后需统一重载，不影响现有人工 GEO。
# R0 只提供配置，启用不代表 Collector、平台合规或数据外发已获批准。
GEO_MONITORING_ENABLED=false
GEO_API_COLLECTION_ENABLED=false
GEO_BROWSER_COLLECTION_ENABLED=false
# GEO-802：需独立受保护卷；API仅持公钥，私钥仅Collector持有。无配置默认不可用。
# GEO_BROWSER_SESSION_ROOT=/run/geo-browser-sessions
# GEO_BROWSER_SESSION_PUBLIC_KEY_FILE=/run/geo-browser-session-public.pem
# GEO_BROWSER_SESSION_SERVICE_KEY_FILE=/run/geo-browser-service.key
# GEO_BROWSER_SESSION_SERVICE_USER_ID=<已批准且启用的ADMIN服务账号UUID>
GEO_OPPORTUNITY_EVALUATION_ENABLED=false
# GEO-405：采集 lease 与补投递；不授予外发/adapter 批准权限。
GEO_PENDING_REDISPATCH_SECONDS=120
GEO_COLLECTION_FINALIZE_GRACE_SECONDS=120
GEO_RECOVERY_SCAN_SECONDS=60
GEO_RECOVERY_BATCH_SIZE=100
# GEO-901：新增保留策略先预览；实际期限需数据负责人批准后显式配置。
GEO_RETENTION_DRY_RUN=true
GEO_RETENTION_BATCH_SIZE=100
# GEO_RAW_PAYLOAD_RETENTION_DAYS=180
# GEO_TERMINAL_DRAFT_RETENTION_DAYS=30
# GEO_UNREFERENCED_FILE_RETENTION_DAYS=7
# GEO-407：可选全局 UTC 日预算；省略表示不限额，未知估价时有预算将阻断。
# GEO_DAILY_BUDGET_LIMIT=100.000000
GEO_DAILY_BUDGET_CURRENCY=USD

# Development 对象存储。Production 不得使用这些 fake/local endpoint。
OBJECT_STORAGE_BACKEND=development
OBJECT_STORAGE_ENDPOINT=http://fake-oss:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:19001
OBJECT_STORAGE_PATH=/data
UPLOAD_SIGNING_SECRET=development-upload-signing-secret
UPLOAD_INTENT_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300

# Aliyun OSS。开发选择 aliyun_oss 时填四项；生产填写独立 .env.production。
# 禁止把真实值写入本示例。
# OSS_ENDPOINT 必须是与 bucket region 对应的 HTTPS aliyuncs.com endpoint。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 前端同源部署保持为空；仅在明确的跨源环境中设置 API origin。
VITE_API_BASE_URL=
# Vite 开发代理使用进程环境：VITE_API_PROXY_TARGET=http://localhost:18000。
# Dev Compose 已固定注入 http://api:8000；根 .env 不会自动传给宿主机 Vite。
