+            onClick={() => remove(index)}
+            type="button"
+            variant="outline"
+          >
+            删除引用
+          </Button>
+        </div>
+      ))}
+      <Button
+        disabled={fields.length >= 1000}
+        onClick={() => {
+          const used = new Set(getValues('citations').map((citation) => citation.position));
+          let position = 1;
+          while (used.has(position) && position < 1000) position += 1;
+          append({ original_url: '', title: '', position });
+        }}
+        type="button"
+        variant="outline"
+      >
+        添加引用
+      </Button>
