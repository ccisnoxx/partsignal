# Production 运行时完整模板（35 项）。复制到本地 .env.production，权限 0600。
# 内部密码/密钥由部署准备生成，DATABASE_URL派生；用户仅提供外部服务信息。
# 空值由负责方补齐并校验；这份模板不能直接部署，也不能覆盖已配置的服务器文件。
# 开发 .env 与生产 .env.production 分别维护，禁止把开发默认值复制到生产。
# 完整流程、每项归属及 AI 初始化输入见 docs/production-configuration.md。
# 使用单行 literal key=value；禁止插值、引号、内联注释、控制字符、CRLF、source/include。
# database/session/seed/storage secrets 首次用 CSPRNG 至少 32 字节经 URL-safe 编码，
# 只含 A-Z/a-z/0-9/_/-（至少 43 字符）；既有环境保留原值，不因此重新生成或轮换。
# AI encryption key 仍为随机 32 字节的标准 Base64，OSS 凭据由供应商提供。
# 本地检查：uv run --project backend python deploy/scripts/check-production-inputs.py .env.production --ai-inputs .env.production.ai.json

APP_ENV=production
# 历史记录字段：当前 Settings/Compose 不读取下面三个字段。
# 域名实际由 Nginx、CORS 与前端构建决定；LOG_LEVEL 不控制进程日志级别。
APP_BASE_URL=https://geo.962850.xyz
API_BASE_URL=http://api:8000
LOG_LEVEL=INFO

# PostgreSQL：密码首次安装生成一次；DATABASE_URL 使用同一 user/password/db。
# 容器内固定 postgres:5432，不使用宿主机开发端口 55432。
# URL 中密码需做 URL percent encoding；POSTGRES_PASSWORD 保留原值。
DATABASE_URL=
POSTGRES_DB=partsignal
POSTGRES_USER=partsignal
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/0

# 随机 session secret，至少 32 字符；已运行环境复用既有值。
SESSION_SECRET=
SESSION_COOKIE_NAME=partsignal_session
CSRF_COOKIE_NAME=partsignal_csrf
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://geo.962850.xyz

# 首次空库初始化账号密码：分别随机生成，至少 12 字符；非日常密码重置接口。
PARTSIGNAL_SEED_ADMIN_PASSWORD=
PARTSIGNAL_SEED_ENGINEER_PASSWORD=
# 历史记录字段：当前 Compose worker command 固定 --concurrency=1。
CELERY_CONCURRENCY=1

# AI provider/model/API Key 不放入这个文件，详见 AI 初始化模板。
CONTENT_GENERATOR=openai-compatible
# 独立随机 32 字节经 Base64 编码。必须与数据库备份成对保管；不能随发布重生成。
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_ALLOW_LOCAL_HTTP=false
GENERATION_EAGER=false
GENERATION_PENDING_REDISPATCH_SECONDS=120
GENERATION_FINALIZE_GRACE_SECONDS=120
GENERATION_RECOVERY_BATCH_SIZE=100
GENERATION_RECOVERY_SCAN_SECONDS=60

# 生产只使用真实 Aliyun OSS；不添加 fake-oss endpoint/path、19001 或 /object-storage/。
OBJECT_STORAGE_BACKEND=aliyun_oss
# 兼容保留的 storage signing secret：独立随机生成；aliyun_oss 路径不使用开发签名。
UPLOAD_SIGNING_SECRET=
UPLOAD_INTENT_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300
# Endpoint 必须对应 Bucket region，使用 HTTPS aliyuncs.com；AccessKey 为低权限凭据。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 构建输入：Hostdzire 前端同源，固定空值。frontend 容器不读取此运行时 env 文件。
VITE_API_BASE_URL=
