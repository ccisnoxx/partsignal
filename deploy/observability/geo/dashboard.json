          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "title": "当前分析有效复核积压",
      "type": "timeseries",
      "description": "按当前revision与同revision有效复核判断。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
