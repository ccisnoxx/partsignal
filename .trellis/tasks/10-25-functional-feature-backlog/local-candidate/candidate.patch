+              { kind: 'collection_profile_ids', label: 'Profile' },
+            ] as const
+          ).map(({ kind, label }) => (
+            <EvaluationOptions
+              key={kind}
+              kind={kind}
+              label={label}
+              value={values[kind]}
+              disabled={disabled}
