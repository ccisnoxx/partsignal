+def test_permissions_csrf_missing_run_and_current_session_revalidation(plans_api, monkeypatch):
+    api = plans_api
+    run = batch_run(api)[0]
+    body = {"expected_revision": 0, "expected_draft_revision": 0, "reason": "虚构取消"}
+    with TestClient(app) as anonymous:
