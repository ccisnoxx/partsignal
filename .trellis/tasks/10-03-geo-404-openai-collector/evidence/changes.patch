+                                    "url": "https://example.com/b",
+                                    "title": "后",
+                                    "start_index": 5,
+                                    "end_index": 7,
+                                },
+                            },
+                            {
+                                "type": "url_citation",
+                                "url_citation": {
+                                    "url": "https://example.com/a",
+                                    "title": "前",
+                                    "start_index": 0,
+                                    "end_index": 2,
+                                },
+                            },
+                        ],
+                    }
+                }
+            ]
+        }
