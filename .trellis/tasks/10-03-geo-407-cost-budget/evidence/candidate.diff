+                "SELECT count(*) FROM geo_collection_reservations WHERE estimated_amount IS NULL "
+                "AND estimated_currency IS NULL"
+            ).fetchone()[0]
+            == 3
+        )
+        days = dict(
+            conn.execute("SELECT run_id,budget_day FROM geo_collection_reservations").fetchall()
+        )
