{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "受保护partsignal-geo采集任务",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "partsignal-geo-902",
  "title": "PartSignal GEO 系统运行与成本",
  "tags": [
    "partsignal",
    "geo",
    "operations"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "快照状态",
      "type": "timeseries",
      "description": "缺失、0或超过180秒快照告警。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_observability_up{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Worker/Scheduler心跳年龄",
      "type": "timeseries",
      "description": "记录实际循环；不能证明业务计划扫描已接线。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - geo_operation_last_success_timestamp_seconds{job=\"partsignal-geo\",operation=~\"worker_heartbeat|scheduler_tick\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "运行状态（采集模式独立）",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_run_status_count{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "批次状态",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_batch_status_count{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Pending数量",
      "type": "timeseries",
      "description": "MANUAL_ENTRY是待人工录入；不触发自动采集告警。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_pending_count{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "最老Pending年龄",
      "type": "timeseries",
      "description": "来自当前阶段开始时间；分析不继承此前人工待录入年龄。snapshot定位稳定ID。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_pending_oldest_seconds{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "最老补投递Due年龄",
      "type": "timeseries",
      "description": "根据last_dispatch_attempt_at，不替代最老Pending年龄。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_dispatch_due_oldest_seconds{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "过期lease",
      "type": "timeseries",
      "description": "采集/分析分开；包括终态Run的重分析。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_running_expired_count{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "24小时运行技术失败",
      "type": "timeseries",
      "description": "Opportunity业务低表现不参与系统告警。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
