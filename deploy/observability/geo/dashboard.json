        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geo_run_failure_count_24h{job=\"partsignal-geo\"}",
          "legendFormat": "{{mode}} {{stage}} {{status}} {{operation}} {{currency}} {{error_code}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "title": "24小时分析任务失败",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
