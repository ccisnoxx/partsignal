+def counts(api):
+    with api.harness.factory() as db:
+        return tuple(
+            count(db, model)
+            for model in (
+                ContentTask,
+                FactVersion,
+                PublishedArticle,
+                PublishedContentIssue,
+                GeoOpportunityAction,
+            )
+        )
