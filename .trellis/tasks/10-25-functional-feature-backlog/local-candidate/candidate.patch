+@pytest.mark.parametrize("mismatch", ["scope", "rule"])
+def test_window_guard_rejects_receipt_from_another_scope_or_rule(api, mismatch):
+    value = active(api, scope="FILTERED", subject_ids=[str(uuid4())])
