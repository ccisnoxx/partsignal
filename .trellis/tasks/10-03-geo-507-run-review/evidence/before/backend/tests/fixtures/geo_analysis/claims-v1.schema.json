{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": "geo-claims-gold-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "subject_ids",
          "fact_body",
          "fact_status",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fact_body": {
            "type": [
              "string",
              "null"
            ]
          },
          "fact_status": {
            "enum": [
              "APPROVED",
              "PENDING_REVIEW",
              "CHANGES_REQUESTED",
              "RETIRED"
            ]
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claims",
              "review_required_reasons"
            ],
            "properties": {
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "subject_id",
                    "claim_kind",
                    "verdict",
                    "severity"
                  ],
                  "properties": {
                    "subject_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claim_kind": {
                      "enum": [
                        "IDENTITY",
                        "PARAMETER",
                        "PACKAGE",
                        "TEMPERATURE_GRADE",
                        "CERTIFICATION",
                        "LIFECYCLE_STATUS",
                        "APPLICATION",
                        "REPLACEMENT_RELATION",
                        "COMPATIBILITY_CONDITION",
                        "OTHER"
                      ]
                    },
                    "verdict": {
                      "enum": [
                        "ACCURATE",
                        "PARTIAL",
                        "INCORRECT",
                        "UNJUDGEABLE"
                      ]
                    },
                    "severity": {
                      "enum": [
                        "LOW",
                        "MEDIUM",
                        "HIGH",
                        "CRITICAL"
                      ]
                    }
                  }
                }
              },
              "review_required_reasons": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
