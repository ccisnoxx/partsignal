# 服务器开发预览模板（38项）：APP_ENV=staging，不是正式 Production。
# 这是完整 runtime 合同；系统生成项不是要求用户填写的输入。
# 首次准备：uv run --project backend python deploy/scripts/prepare-preview-env.py --origin https://geo.962850.xyz
# 该命令排他创建 .env.staging，自动生成密码/密钥并填写关联 DATABASE_URL；不部署、不上传。
# 后续发布复用既有文件，不能重新生成；开发预览说明见 docs/development-preview.md。
# 默认关闭正式 AI 业务生成，使用开发对象存储；真实 AI/OSS 按需单独配置。

APP_ENV=staging
APP_BASE_URL=https://geo.962850.xyz
API_BASE_URL=http://api:8000
LOG_LEVEL=INFO
# 自动生成/派生：不需要用户提供。
DATABASE_URL=
POSTGRES_DB=partsignal
POSTGRES_USER=partsignal
# 自动生成/派生：不需要用户提供。
POSTGRES_PASSWORD=
REDIS_URL=redis://redis:6379/0
# 自动生成/派生：不需要用户提供。
SESSION_SECRET=
SESSION_COOKIE_NAME=partsignal_session
CSRF_COOKIE_NAME=partsignal_csrf
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=https://geo.962850.xyz
# 自动生成/派生：不需要用户提供。
PARTSIGNAL_SEED_ADMIN_PASSWORD=
# 自动生成/派生：不需要用户提供。
PARTSIGNAL_SEED_ENGINEER_PASSWORD=
CELERY_CONCURRENCY=1
# deterministic 是业务 no-egress 兼容值，不是固定成功的 AI 适配器。
# 真实生成/自然化/重试需要 openai-compatible；管理员模型测试/发现独立允许。
CONTENT_GENERATOR=deterministic
# 自动生成/派生：不需要用户提供。
AI_CREDENTIAL_ENCRYPTION_KEY=
AI_ALLOW_LOCAL_HTTP=false
GENERATION_EAGER=false
GENERATION_PENDING_REDISPATCH_SECONDS=120
GENERATION_FINALIZE_GRACE_SECONDS=120
GENERATION_RECOVERY_BATCH_SIZE=100
GENERATION_RECOVERY_SCAN_SECONDS=60
OBJECT_STORAGE_BACKEND=development
OBJECT_STORAGE_ENDPOINT=http://fake-oss:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://geo.962850.xyz/object-storage
OBJECT_STORAGE_PATH=/data
# 自动生成/派生：不需要用户提供。
UPLOAD_SIGNING_SECRET=
UPLOAD_INTENT_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=300
# 可选：仅测试真实 Aliyun OSS 时由用户提供；默认开发对象存储不需要。
OSS_ENDPOINT=
# 可选：仅测试真实 Aliyun OSS 时由用户提供；默认开发对象存储不需要。
OSS_BUCKET=
# 可选：仅测试真实 Aliyun OSS 时由用户提供；默认开发对象存储不需要。
OSS_ACCESS_KEY_ID=
# 可选：仅测试真实 Aliyun OSS 时由用户提供；默认开发对象存储不需要。
OSS_ACCESS_KEY_SECRET=
VITE_API_BASE_URL=
