+_TURN = re.compile(r"\b(?:but|however|instead)\b|但是|但|然而|而是", re.IGNORECASE)
+_NEGATION = re.compile(
+    r"\bnot\b(?!\s+(?:only|just)\b)|\b(?:no|never|cannot|avoid|unsuitable)\b"
+    r"|不推荐|不建议|不适合|不支持|不能|不可|避免|未提及|未推荐|不是|并非|没有",
+    re.IGNORECASE,
+)
