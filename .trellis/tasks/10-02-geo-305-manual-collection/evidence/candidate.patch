+
+from alembic import op
+
+revision = "0051_geo_manual_collection"
+down_revision = "0050_geo_answer_evidence"
+branch_labels = None
+depends_on = None
+
+
+def upgrade() -> None:
+    sql_dir = Path(__file__).resolve().parents[1] / "sql"
+    op.execute((sql_dir / "0051_geo_manual_collection.sql").read_text())
+
