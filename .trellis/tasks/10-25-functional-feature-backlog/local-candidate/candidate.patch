+"""机会发布修复候选：保存范围由GEO拥有，发布资格与修复上下文由原领域拥有。"""
+
+from uuid import UUID
+
+from sqlalchemy import select
+from sqlalchemy.orm import Session
+
+from app.errors import AppError, not_found
+from app.models.geo_opportunities import GeoOpportunity
+from app.models.identity import User
+from app.schemas.geo_opportunities import GeoOpportunityActionType, GeoOpportunityStatus
+from app.schemas.geo_opportunity_actions import (
+    GeoOpportunityPublicationRepairCandidate,
+    GeoOpportunityPublicationRepairOptions,
+)
+from app.schemas.geo_opportunity_actions import (
+    GeoOpportunityPublicationRepairMode as Mode,
+)
+from app.schemas.geo_rules import GeoRuleCode
+from app.services import publication_queries
+from app.services.geo_opportunity_policy import action_types
+from app.services.geo_opportunity_product_scope import saved_own_product_ids
+from app.services.geo_opportunity_queries import _as_of
+
+
+def get_publication_repair_options(
+    db: Session,
+    opportunity_id: UUID,
+    *,
+    actor: User,
+    mode: Mode,
+    page: int,
+    page_size: int,
+    selected_issue_id: UUID | None,
+) -> GeoOpportunityPublicationRepairOptions:
+    as_of = _as_of(db)
+    if selected_issue_id is not None and mode != Mode.CREATE_REPAIR:
+        raise AppError("VALIDATION_ERROR", "只有创建修复任务才读取所选问题的修复上下文", 422)
+    opportunity = db.scalar(
+        select(GeoOpportunity)
+        .where(GeoOpportunity.id == opportunity_id)
+        .execution_options(populate_existing=True)
+    )
+    if opportunity is None:
+        raise not_found("GEO机会")
+    offered = GeoOpportunityActionType.PUBLICATION_REPAIR in action_types(
+        GeoOpportunityStatus(opportunity.status), GeoRuleCode(opportunity.rule_code), actor
+    )
+    candidates: list[GeoOpportunityPublicationRepairCandidate] = []
+    total = 0
+    repair_context = None
+    if offered:
+        product_ids = saved_own_product_ids(db, opportunity)
+        if mode == Mode.OPEN_ISSUE:
+            articles = publication_queries.list_published_articles(
+                db, page=page, page_size=page_size, product_ids=product_ids
+            )
+            total = articles.total
+            candidates = [
+                GeoOpportunityPublicationRepairCandidate(
+                    published_article_id=item.id,
+                    published_content_issue_id=None,
+                    issue_revision=None,
+                    actual_title=item.actual_title,
+                    platform_profile_name=item.platform_profile_name,
+                    final_url=item.final_url,
+                    available="OPEN_ISSUE" in item.available_actions,
+                    unavailable_reason=None
+                    if "OPEN_ISSUE" in item.available_actions
+                    else "发布成果已有开放问题或已退役",
+                )
+                for item in articles.items
+            ]
+        else:
+            issues = publication_queries.list_published_content_issues(
+                db, page=page, page_size=page_size, status_filter="OPEN", product_ids=product_ids
+            )
+            total = issues.total
+            candidates = [
+                GeoOpportunityPublicationRepairCandidate(
+                    published_article_id=item.published_article_id,
+                    published_content_issue_id=item.id,
+                    issue_revision=item.revision,
+                    actual_title=item.actual_title,
+                    platform_profile_name=item.platform_profile_name,
+                    final_url=item.final_url,
+                    available=mode == Mode.LINK_ISSUE
+                    or "CREATE_REPAIR_TASK" in item.available_actions,
+                    unavailable_reason="该问题已有修复任务"
+                    if mode == Mode.CREATE_REPAIR
+                    and "CREATE_REPAIR_TASK" not in item.available_actions
+                    else None,
+                )
+                for item in issues.items
+            ]
+        if selected_issue_id is not None:
+            repair_context = publication_queries.get_published_content_repair_context(
+                db, selected_issue_id, can_delete=False
+            )
+            if repair_context.original_task.product_id not in product_ids:
+                raise AppError("VALIDATION_ERROR", "所选问题不属于机会保存的自有产品来源", 422)
+    return GeoOpportunityPublicationRepairOptions(
+        opportunity_id=opportunity.id,
+        opportunity_revision=opportunity.revision,
+        available_action_types=["PUBLICATION_REPAIR"] if offered else [],
+        mode=mode,
+        candidates=candidates,
+        page=page,
+        page_size=page_size,
+        total=total,
+        repair_context=repair_context,
+        as_of=as_of,
+    )
diff --git a/backend/app/services/geo_opportunity_schedule_commands.py b/backend/app/services/geo_opportunity_schedule_commands.py
new file mode 100644
index 0000000000000000000000000000000000000000..131876b03d6bd1f2d7b4187243799d3b33dce5c1
--- /dev/null
+++ b/backend/app/services/geo_opportunity_schedule_commands.py
@@ -0,0 +1,158 @@
+"""管理员周期配置事务owner；User/Session先于配置锁，运行不会改变配置revision。"""
+
+import hashlib
+import json
+from datetime import timedelta
+from typing import Literal
+
+from sqlalchemy import select, text
+from sqlalchemy.orm import Session
+
+from app.audit import append_audit
+from app.audit_types import AuditEntry, AuditModule, AuditOutcome
+from app.errors import AppError
+from app.models.geo_opportunity_schedule import GeoOpportunitySchedule, GeoOpportunityScheduleWindow
+from app.models.geo_rules import GeoRuleSetRevision
+from app.models.identity import User
+from app.schemas.common import AccountType
+from app.schemas.geo_opportunity_schedule import (
+    GeoOpportunityScheduleCommand,
+    GeoOpportunityScheduleDetail,
+    GeoOpportunityScheduleSave,
+)
+from app.services.current_actor import current_actor_command
+from app.services.geo_opportunities import ensure_evaluation_enabled
+from app.services.geo_opportunity_schedule_state import clock, configuration, detail, latest
+
+type ScheduleOperation = Literal["configure", "activate", "pause", "resume"]
+
+
+def conflict() -> AppError:
+    return AppError("REVISION_CONFLICT", "自动评估配置已变化，请重新读取并确认", 409)
+
+
+def change(
+    db: Session,
+    *,
+    actor: User,
+    request_id: str,
+    payload: GeoOpportunityScheduleSave | GeoOpportunityScheduleCommand,
+    operation: ScheduleOperation,
+) -> GeoOpportunityScheduleDetail:
+    db.autoflush = False
+    with current_actor_command(db, actor, allowed=(AccountType.ADMIN,)) as current:
+        db.execute(
+            text("SELECT pg_advisory_xact_lock(hashtextextended('geo-opportunity-schedule',0))")
+        )
+        row = db.scalar(
+            select(GeoOpportunitySchedule)
+            .where(GeoOpportunitySchedule.id == 1)
+            .with_for_update()
+            .execution_options(populate_existing=True)
+        )
+        if (row.revision if row else 0) != payload.expected_revision:
+            raise conflict()
+        now = clock(db)
+        value = (
+            payload.configuration
+            if isinstance(payload, GeoOpportunityScheduleSave)
+            else configuration(row)
+            if row
+            else None
+        )
+        if value is None:
+            raise AppError("INVALID_STATE_TRANSITION", "请先保存自动评估配置", 409)
+        if db.get(GeoRuleSetRevision, value.rule_set_revision) is None:
+            raise AppError("RESOURCE_NOT_FOUND", "所选GEO规则revision不存在", 404)
+        target = row.status if row else "DISABLED"
+        if operation != "configure":
+            targets = {
+                "activate": ("DISABLED", "ACTIVE"),
+                "pause": ("ACTIVE", "PAUSED"),
+                "resume": ("PAUSED", "ACTIVE"),
+            }
+            source, target = targets[operation]
+            if row is None or row.status != source:
+                raise AppError("INVALID_STATE_TRANSITION", "当前状态不允许此操作", 409)
+        if target == "ACTIVE":
+            ensure_evaluation_enabled()
+        data = value.model_dump(mode="json", exclude={"rule_set_revision"})
+        if row is not None and (
+            row.configuration,
+            row.rule_set_revision,
+            row.status,
+            row.authorizer_id,
+        ) == (data, value.rule_set_revision, target, current.id):
+            return detail(db)
+        last = latest(db)
+        floor = max(
+            [now]
+            + ([last.scheduled_for] if last else [])
+            + ([last.covered_until] if last and last.covered_until else [])
+        )
+        if row is not None and row.next_run_at is not None and row.next_run_at <= now:
+            db.add(
+                GeoOpportunityScheduleWindow(
+                    schedule_id=1,
+                    scheduled_for=row.next_run_at,
+                    configuration_revision=row.revision,
+                    configuration_snapshot=row.configuration,
+                    rule_set_revision=row.rule_set_revision,
+                    status="MISSED",
+                    error_code="SUPERSEDED",
+                    covered_until=now + timedelta(microseconds=1),
+                )
+            )
+        if row is None:
+            row = GeoOpportunitySchedule(
+                id=1,
+                configuration=data,
+                rule_set_revision=value.rule_set_revision,
+                authorizer_id=current.id,
+                status="DISABLED",
+                revision=1,
+                next_run_at=None,
+            )
+            db.add(row)
+        else:
+            row.configuration = data
+            row.rule_set_revision = value.rule_set_revision
+            row.authorizer_id = current.id
+            row.status = target
+            row.revision += 1
+            row.updated_at = max(now, row.updated_at)
+        row.next_run_at = (
+            floor + timedelta(hours=value.interval_hours) if target == "ACTIVE" else None
+        )
+        db.flush()
+        action = {
+            "configure": "configured",
+            "activate": "activated",
+            "pause": "paused",
+            "resume": "resumed",
+        }[operation]
+        append_audit(
+            db,
+            AuditEntry(
+                actor_id=current.id,
+                business_module=AuditModule.GEO_OBSERVATION,
+                action="geo_opportunity_schedule." + action,
+                target_type="GeoOpportunitySchedule",
+                target_id="1",
+                request_id=request_id,
+                outcome=AuditOutcome.SUCCESS,
+                result_message="机会自动评估配置已变更",
+                details={
+                    "facts": {
+                        "revision": row.revision,
+                        "scope": value.scope,
+                        "filter_sha256": hashlib.sha256(
+                            json.dumps(value.model_dump(mode="json"), sort_keys=True).encode()
+                        ).hexdigest(),
+                    }
+                },
+            ),
+        )
+        result = detail(db)
+        db.commit()
+        return result
diff --git a/backend/app/services/geo_opportunity_schedule_state.py b/backend/app/services/geo_opportunity_schedule_state.py
new file mode 100644
index 0000000000000000000000000000000000000000..b4b1b3712992da2a24fd742528891f43ccb9cbbe
--- /dev/null
+++ b/backend/app/services/geo_opportunity_schedule_state.py
@@ -0,0 +1,97 @@
+"""周期评估自己的配置/窗口投影；不借用监测计划的运行状态。"""
+
+from datetime import datetime
+
+from sqlalchemy import func, select
+from sqlalchemy.orm import Session
+
+from app.config import settings
+from app.models.geo_opportunity_evaluation import GeoOpportunityEvaluationRun
+from app.models.geo_opportunity_schedule import GeoOpportunitySchedule, GeoOpportunityScheduleWindow
+from app.models.identity import User
+from app.schemas.geo_opportunity_evaluation import GeoOpportunityEvaluationReceipt
+from app.schemas.geo_opportunity_schedule import (
+    GeoOpportunityScheduleConfiguration,
+    GeoOpportunityScheduleDetail,
+    GeoOpportunityScheduleWindowOut,
+)
+
+
+def enabled() -> bool:
+    return settings.geo_monitoring_enabled and settings.geo_opportunity_evaluation_enabled
+
+
+def clock(db: Session) -> datetime:
+    value = db.scalar(select(func.clock_timestamp()))
+    assert isinstance(value, datetime)
+    return value
+
+
+def configuration(
+    row: GeoOpportunitySchedule | GeoOpportunityScheduleWindow,
+) -> GeoOpportunityScheduleConfiguration:
+    value = (
+        row.configuration if isinstance(row, GeoOpportunitySchedule) else row.configuration_snapshot
+    )
+    return GeoOpportunityScheduleConfiguration.model_validate(
+        value | {"rule_set_revision": row.rule_set_revision}
+    )
+
+
+def latest(db: Session) -> GeoOpportunityScheduleWindow | None:
+    return db.scalar(
+        select(GeoOpportunityScheduleWindow)
+        .where(GeoOpportunityScheduleWindow.schedule_id == 1)
+        .order_by(GeoOpportunityScheduleWindow.scheduled_for.desc())
+        .limit(1)
+    )
+
+
+def detail(db: Session) -> GeoOpportunityScheduleDetail:
+    row = db.get(GeoOpportunitySchedule, 1, populate_existing=True)
+    recent = latest(db) if row is not None else None
+    window = None
+    if recent is not None:
+        receipt = (
+            db.get(GeoOpportunityEvaluationRun, recent.evaluation_run_id)
+            if recent.evaluation_run_id
+            else None
+        )
+        window = GeoOpportunityScheduleWindowOut(
+            scheduled_for=recent.scheduled_for,
+            configuration_revision=recent.configuration_revision,
+            configuration=configuration(recent),
+            status=recent.status,
+            covered_until=recent.covered_until,
+            error_code=recent.error_code,
+            created_at=recent.created_at,
+            receipt=GeoOpportunityEvaluationReceipt.model_validate(receipt.receipt)
+            if receipt
+            else None,
+        )
+    actions = ["CONFIGURE"]
+    if row is not None:
+        if row.status == "ACTIVE":
+            actions.append("PAUSE")
+        elif enabled():
+            actions.append("ACTIVATE" if row.status == "DISABLED" else "RESUME")
+    blocked = None if enabled() else "GEO_MONITORING_DISABLED"
+    if blocked is None and row is not None:
+        authorizer = db.get(User, row.authorizer_id)
+        assert authorizer is not None  # RESTRICT FK保证当前授权身份可读取。
+        if not authorizer.is_active:
+            blocked = "AUTH_REQUIRED"
+        elif authorizer.must_change_password:
+            blocked = "PASSWORD_CHANGE_REQUIRED"
+        elif authorizer.account_type != "ADMIN":
+            blocked = "PERMISSION_DENIED"
+    return GeoOpportunityScheduleDetail(
+        revision=row.revision if row else 0,
+        status=row.status if row else "UNCONFIGURED",
+        configuration=configuration(row) if row else None,
+        authorizer_id=row.authorizer_id if row else None,
+        next_run_at=row.next_run_at if row else None,
+        latest_window=window,
+        available_actions=actions,
+        blocked_reason=blocked,
+    )
