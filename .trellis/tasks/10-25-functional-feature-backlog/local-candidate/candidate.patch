+        <p className="type-label">周期评估采集模式（空选表示所有历史模式）</p>
+        <div className="flex flex-wrap gap-2">
+          {(['MANUAL', 'API', 'BROWSER'] as const).map((mode) => (
+            <Button
+              key={mode}
+              type="button"
+              variant="outline"
+              disabled={disabled}
+              aria-pressed={values.collection_modes.includes(mode)}
