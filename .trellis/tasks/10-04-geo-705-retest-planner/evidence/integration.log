                    "action_type": "OTHER",
                    "target_type": "PublishedContentIssue",
                    "target_id": uuid4(),
                    "status_snapshot": "OPEN",
                    "created_by": db.plan.actor,
                },
            )
            legacy = conn.execute(
                "SELECT to_jsonb(t) FROM geo_opportunity_actions t WHERE id=%s", (action_id,)
