+"""复核发布不允许重写采集终态字段。"""
+
+import psycopg
+import pytest
+
+from tests.integration.geo_analysis_support import review
+from tests.integration.geo_reviews_support import (
+    analysis_engine,
+    answer_database,
+    harness,
+    plan_database,
