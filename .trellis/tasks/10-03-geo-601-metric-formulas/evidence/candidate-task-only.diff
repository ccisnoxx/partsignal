+"""一致快照转换不选历史最佳分析，只消费 pointer 内当前人工修正。"""
+
+from datetime import UTC, datetime
+from hashlib import sha256
+from uuid import UUID, uuid4
+
+import pytest
+
+from app.schemas.geo_analysis import (
+    GeoAnalysisRevisionOut,
