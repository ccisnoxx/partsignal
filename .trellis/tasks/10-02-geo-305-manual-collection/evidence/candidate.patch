+                    ),
+                    actor=actor,
+                    request_id=str(uuid4()),
+                ).draft_revision
+            except AppError as error:
+                return error.code
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(invoke, range(2)))
