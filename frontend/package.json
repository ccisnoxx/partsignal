{
  "name": "partsignal-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 && node scripts/check-theme-colors.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "perf:production": "npm run build && node scripts/measure-production-performance.mjs",
    "api:generate": "openapi-typescript ../contracts/openapi.yaml -o src/shared/api/schema.d.ts",
    "api:check": "node scripts/check-openapi.mjs",
    "generate:api": "npm run api:generate"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.1",
    "@tanstack/react-query": "^5.90.20",
    "antd": "^6.2.0",
    "dayjs": "^1.11.19",
    "dompurify": "^3.4.11",
    "marked": "^17.0.1",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
