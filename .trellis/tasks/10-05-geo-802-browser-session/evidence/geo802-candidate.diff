+    vault_files: tuple[Path, Path], private_key: rsa.RSAPrivateKey, kind: str
+) -> None:
+    root, key = vault_files
+    if kind == "root-missing":
+        root = root / "missing"
+    elif kind == "root-other":
+        root.chmod(0o701)
