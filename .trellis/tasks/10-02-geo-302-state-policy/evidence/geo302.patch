+        (
+            schemas.GeoRunWorkflowProjection,
+            {
+                "workflow_stage": "MANUAL_ENTRY_REQUIRED",
+                "primary_task": "ENTER_MANUAL_OBSERVATION",
+                "available_actions": ["ENTER_MANUAL_OBSERVATION", "CANCEL"],
+            },
+        ),
