+def state() -> str:
+    return json.dumps(
+        {
+            "cookies": [
+                {
+                    "name": "session",
+                    "value": CANARY,
+                    "domain": "example.com",
+                    "path": "/",
+                    "expires": -1,
+                    "httpOnly": True,
+                    "secure": True,
