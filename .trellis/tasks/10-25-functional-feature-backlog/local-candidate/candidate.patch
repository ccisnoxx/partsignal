+    expect(blocking).toHaveBeenLastCalledWith(true);
+    expect(upload).not.toHaveBeenCalled();
+    await user.click(screen.getByRole('button', { name: '合成并预览截图' }));
+    expect(await screen.findByRole('button', { name: '上传合成截图' })).toBeEnabled();
